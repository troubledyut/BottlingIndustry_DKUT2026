TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 638693289}
  m_Text: "ChainElementFollowPosition:\r\n- needs Unity Spline\r\n- ChainElements
    are directly connected to \r\n  the Drive and the Chain\r\n- the Chain has no
    ChainElement defined and uses\r\n  \"ScaledOnFixedLength\". With this the real
    length\r\n  of the Spline is not relevant for the position of\r\n  the ChainElement.
    The position is set by the Drive"
